# ==============================================================================
# Backend Server Environment Variables
# ==============================================================================
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
